<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/market_accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/market_background</item>
        <item name="android:navigationBarColor">@color/market_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/market_background</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="MarketPageTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">26sp</item><item name="android:textColor">@color/market_ink</item>
    </style>
    <style name="MarketSectionTitle" parent="android:style/TextAppearance.Material.Title">
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">20sp</item><item name="android:textColor">@color/market_ink</item>
    </style>
    <style name="MarketCardTitle" parent="android:style/TextAppearance.Material.Subhead">
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">17sp</item><item name="android:textColor">@color/market_ink</item>
    </style>
    <style name="MarketBody" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">16sp</item><item name="android:textColor">@color/market_ink</item>
    </style>
    <style name="MarketMeta" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">14sp</item><item name="android:textColor">@color/market_muted</item>
    </style>
    <style name="MarketCaption" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:textSize">12sp</item><item name="android:textColor">@color/market_muted</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">@dimen/button_height</item>
        <item name="android:layout_marginTop">@dimen/space_16</item><item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/button_primary_text</item><item name="android:background">@drawable/button_primary_background</item>
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">16sp</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="SecondaryButton" parent="ActionButton">
        <item name="android:background">@drawable/button_secondary_background</item><item name="android:textColor">@color/button_secondary_text</item>
    </style>
    <style name="DangerButton" parent="SecondaryButton">
        <item name="android:background">@drawable/button_danger_background</item><item name="android:textColor">@color/market_danger</item>
    </style>
    <style name="InputField" parent="android:style/Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item><item name="android:layout_marginTop">@dimen/space_8</item>
        <item name="android:paddingStart">14dp</item><item name="android:paddingEnd">14dp</item><item name="android:paddingTop">12dp</item><item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/input_background</item><item name="android:textColor">@color/market_ink</item><item name="android:textColorHint">@color/market_muted</item>
        <item name="android:textSize">16sp</item><item name="android:singleLine">true</item>
    </style>
    <style name="MarketQuietButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">64dp</item><item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item><item name="android:textColor">@color/market_ink</item><item name="android:textAllCaps">false</item><item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="MarketSearchButton" parent="ActionButton">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">0dp</item><item name="android:minWidth">64dp</item><item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="MarketMoreButton" parent="SecondaryButton">
        <item name="android:layout_marginTop">0dp</item><item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="MarketNavigation" parent="android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item>
        <item name="android:minHeight">64dp</item><item name="android:button">@null</item><item name="android:gravity">center</item>
        <item name="android:paddingVertical">8dp</item><item name="android:drawablePadding">4dp</item>
        <item name="android:background">@drawable/navigation_background</item><item name="android:drawableTint">@color/navigation_text</item>
        <item name="android:textColor">@color/navigation_text</item><item name="android:textSize">12sp</item><item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
