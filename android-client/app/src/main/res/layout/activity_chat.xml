<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/chat_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/screen_padding">
 <Button android:id="@+id/chat_back" style="@style/MarketQuietButton" android:text="@string/back" />
 <TextView android:id="@+id/chat_heading" style="@style/MarketSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_title" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="@dimen/space_8" />
 <TextView android:id="@+id/chat_product_note" style="@style/MarketCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" />
 <TextView android:id="@+id/chat_status" style="@style/MarketCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:layout_marginTop="@dimen/space_8" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
  <Button android:id="@+id/chat_refresh" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/chat_refresh" />
  <Button android:id="@+id/chat_older" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/chat_older" android:visibility="gone" />
 </LinearLayout>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/chat_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="@dimen/space_8" android:clipToPadding="false" android:paddingVertical="@dimen/space_8" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:baselineAligned="false">
  <EditText android:id="@+id/chat_input" style="@style/InputField" android:layout_width="0dp" android:layout_weight="1" android:hint="@string/message_hint" android:inputType="textMultiLine|textCapSentences" android:singleLine="false" android:maxLines="3" android:maxLength="2000" android:autofillHints="" />
  <Button android:id="@+id/chat_send" style="@style/ActionButton" android:layout_width="wrap_content" android:layout_marginStart="@dimen/space_8" android:text="@string/message_send" android:enabled="false" />
 </LinearLayout>
</LinearLayout>
