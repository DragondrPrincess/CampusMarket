<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/detail_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding" android:orientation="vertical">
        <Button android:id="@+id/detail_back" style="@style/MarketQuietButton" android:text="@string/back" />
        <TextView android:id="@+id/detail_status" style="@style/MarketMeta"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/detail_retry" style="@style/SecondaryButton" android:text="@string/catalog_retry" android:visibility="gone" />
        <LinearLayout android:id="@+id/detail_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/detail_no_photo" android:layout_width="match_parent" android:layout_height="280dp"
                android:gravity="center" android:background="@drawable/card_background" android:layout_marginTop="@dimen/space_12"
                android:text="@string/catalog_no_photo" android:textColor="@color/market_muted" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12" android:scrollbars="none">
                <LinearLayout android:id="@+id/detail_images" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
            <TextView android:id="@+id/detail_title" style="@style/MarketPageTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" />
            <TextView android:id="@+id/detail_price" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:textColor="@color/market_ink" />
            <TextView android:id="@+id/detail_meta" style="@style/MarketMeta"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:lineSpacingExtra="6dp" />
            <Button android:id="@+id/detail_buy" style="@style/ActionButton" android:text="@string/order_buy" android:enabled="false" />
            <Button android:id="@+id/detail_contact" style="@style/SecondaryButton" android:text="@string/contact_seller" android:enabled="false" />
            <Button android:id="@+id/detail_favorite" style="@style/SecondaryButton" android:text="@string/product_favorite" />
            <TextView style="@style/MarketSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32" android:text="@string/catalog_description" />
            <TextView android:id="@+id/detail_description" style="@style/MarketBody"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
                android:lineSpacingExtra="6dp" android:textIsSelectable="true" />
            <TextView android:id="@+id/detail_seller" style="@style/MarketMeta"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24"
                android:padding="@dimen/space_16" android:background="@drawable/card_background" android:lineSpacingExtra="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
