<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginBottom="@dimen/space_12" android:padding="@dimen/space_16"
    android:background="@drawable/card_background" android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/order_card_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/market_accent_ink" />
        <TextView android:id="@+id/order_card_id" style="@style/MarketCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@+id/order_card_title" style="@style/MarketCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/order_card_price" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="@color/market_ink" />
    <TextView android:id="@+id/order_card_meta" style="@style/MarketMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8" android:lineSpacingExtra="4dp" />
</LinearLayout>
