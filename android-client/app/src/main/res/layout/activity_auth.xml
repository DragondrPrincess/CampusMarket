<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/auth_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/screen_padding" android:orientation="vertical">
        <Button android:id="@+id/auth_back" style="@style/MarketQuietButton" android:text="@string/back" />
        <TextView android:id="@+id/auth_title" style="@style/MarketPageTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" android:text="@string/login_title" />
        <TextView style="@style/MarketMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/tagline" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:padding="@dimen/space_16" android:background="@drawable/card_background" android:orientation="vertical">
            <EditText android:id="@+id/username" style="@style/InputField" android:hint="@string/username_hint"
                android:inputType="textVisiblePassword" android:maxLength="32" android:autofillHints="username" />
            <EditText android:id="@+id/password" style="@style/InputField" android:hint="@string/password_hint"
                android:inputType="textPassword" android:maxLength="128" android:saveEnabled="false" android:autofillHints="password" />
            <EditText android:id="@+id/confirm_password" style="@style/InputField" android:hint="@string/confirm_password"
                android:inputType="textPassword" android:maxLength="128" android:saveEnabled="false" android:visibility="gone"
                android:importantForAutofill="no" />
            <EditText android:id="@+id/nickname" style="@style/InputField" android:hint="@string/nickname_hint"
                android:inputType="textPersonName" android:maxLength="40" android:visibility="gone" android:importantForAutofill="no" />
            <TextView android:id="@+id/auth_status" style="@style/MarketMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/auth_submit" style="@style/ActionButton" android:text="@string/login" />
            <Button android:id="@+id/auth_switch" style="@style/SecondaryButton" android:text="@string/switch_register" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
