<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="@dimen/space_8" tools:ignore="UselessParent">
 <LinearLayout android:id="@+id/message_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/space_12" android:paddingVertical="10dp" android:background="@drawable/card_background">
  <TextView android:id="@+id/message_content" style="@style/MarketBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="280dp" android:textIsSelectable="true" />
  <TextView android:id="@+id/message_time" style="@style/MarketCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="280dp" android:layout_marginTop="@dimen/space_4" />
 </LinearLayout>
</FrameLayout>
